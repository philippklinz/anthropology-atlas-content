  "discovery": {
    "summary": {
      "de": "Pflanzenreste am Jangtse, Vorratsgruben in Nordchina und Rückstände in japanischen Töpfen. Drei Fundorte zeigen, wie unterschiedlich Menschen in den Jahrtausenden nach der Kaltzeit Lebensmittel gewannen und verarbeiteten.",
      "en": "Plant remains on the Yangtze, storage pits in northern China, and residues in Japanese pots. Three sites show different ways of obtaining and preparing food in the millennia after the ice age."
    },
    "periods": [
      {
        "id": "postglacial-lifeways",
        "labels": {
          "de": "Neue Lebensweisen nach der Kaltzeit",
          "en": "New Ways of Living After the Ice Age"
        },
        "description": {
          "de": "Vom Ende der letzten Kaltzeit bis zu frühen bäuerlichen Gemeinschaften. Die Kapitel vergleichen Wohnen, Sammeln, Anbau und Tierhaltung in verschiedenen Regionen. Mesolithikum und Jungsteinzeit bezeichnen regionale Entwicklungen mit unterschiedlichen Zeitgrenzen.",
          "en": "From the end of the last glacial period to early farming communities. The chapters compare dwelling, foraging, cultivation and herding across regions. The Mesolithic and Neolithic describe regional developments with different time boundaries."
        }
      }
