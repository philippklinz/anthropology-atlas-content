  "sourceRefs": [
    {
      "sourceId": "source:esmonde-cleary-childeric-burial",
      "role": "supports",
      "locator": "pp. 383–384, “The Franks and northern Gaul”: grave across the river from the fortifications, dress fastener, military symbolism, arms, ring and three horse pits."
    },
    {
      "sourceId": "source:fischer-lind-childeric-coins",
      "role": "supports",
      "locator": "p. 3, introduction: date of the burial, composition of the hoard, four illustrated pierced silver coins, examination after removal from the ground and the authors’ interpretation of the selection; Table II: mints and rulers, including Leo I at Constantinople and Julius Nepos at Ravenna."
    },
    {
      "sourceId": "source:brulet-tournai-excavations-1988",
      "role": "supports",
      "locator": "p. 39, introduction and fig. 1 with caption: discovery by A. Quinquin, recovery by the parish chaplain, cemetery and position of the horse pits in the Saint-Brice neighbourhood."
    },
    {
      "sourceId": "source:connected-communities-tournai-saint-brice",
      "role": "supports",
      "locator": "Site 375, Excavations, Cemetery, Beads and Glass vessels: four campaigns 1983–1986, 21 horses, 11 amber beads in four graves and several kinds of drinking vessel."
    },
    {
      "sourceId": "source:bnf-tournai-signet-56-460",
      "role": "supports",
      "locator": "Inv. 56.460, Description and Matières et techniques: inscription, costume, loss on 5 November 1831, wax impression in Ms. 609 fol. 63v, its rediscovery in 1857 and production of the gilt electrotype."
    },
    {
      "sourceId": "source:bnf-tournai-bee-56-449",
      "role": "supports",
      "locator": "Inv. 56.449, Description, Mesures and Mode d’acquisition: gold and garnet, loop for fastening, 1.6 cm, 1.95 g, reported numbers at discovery and presentation, two recovered after the theft."
    },
    {
      "sourceId": "source:barreveld-identifying-royalty",
      "role": "supports",
      "locator": "Sections “Princely tombs” and “King Childeric”: selection of grave goods by the living, limits of identification by seal and the inference of a capital from a burial."
    },
    {
      "sourceId": "source:chifflet-anastasis-childerici-namur-1655",
      "role": "supports",
      "locator": "Namur copy R6A.0608. Printed p. 96, digitised page 119: Annuli aurei, middle row; p. 322, digitised page 348: insects with and without eyes, arranged in alternating orientations. Title and imprint: Antwerp, 1655."
    },
    {
      "sourceId": "source:chifflet-anastasis-childerici-namur-1655",
      "role": "supports",
      "locator": "Catalogue essay by Olivier Latteur (January 2025), “Contenu”, paragraphs on the 1653 construction site, Chifflet’s medical career, the Plantin-Moretus edition and the Habsburg–Bourbon argument."
    },
    {
      "sourceId": "source:bnf-richelieu-cabinet-history",
      "role": "supports",
      "locator": "“Histoire du Cabinet”, “L’installation du cabinet au sein de la bibliothèque”: gallery above the rue Colbert open to visitors from 1741 and occupied until 1865."
    }
  ],
