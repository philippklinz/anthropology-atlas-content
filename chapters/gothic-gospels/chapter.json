  "sourceRefs": [
    {
      "sourceId": "source:auxentius-life-of-wulfila",
      "role": "supports",
      "locator": "Personal recollection beginning Quem condigne laudare; trilingual writing in Et haec omnia; seven years, expulsion, reception under Constantius and crossing of the Danube in Ubi et post multorum."
    },
    {
      "sourceId": "source:krause-slocum-wulfila",
      "role": "supports",
      "locator": "Opening section Wulfila, excerpt of Philostorgius, Ecclesiastical History 2.5 in Photius’ epitome, followed by the conditional calculation of 347–348."
    },
    {
      "sourceId": "source:schaeferdiek-germanic-christianities",
      "role": "supports",
      "locator": "pp. 52–54, especially p. 53 on the 340s persecution, reception under Constantius, vicinity of Nicopolis ad Istrum, and the later crossing in 376."
    },
    {
      "sourceId": "source:gassman-wolfe-gothic-philippians",
      "role": "supports",
      "locator": "p. 532, introduction and notes 4–8 on Wulfila and his endorsement of the Homoian creed in Constantinople in 360."
    },
    {
      "sourceId": "source:miller-oxford-gothic-grammar",
      "role": "supports",
      "locator": "Chapter 1, discussion immediately before §1.5 and §1.5 on the division of translation work and the codices; §2.1, table 2.1, on letter shapes, order and numeral values."
    },
    {
      "sourceId": "source:project-wulfila-matthew-6-9",
      "role": "supports",
      "locator": "Word analysis of atta, unsar and himinam on fol. 4v (facsimile 8); weihnai begins the next petition on fol. 5r (facsimile 9)."
    },
    {
      "sourceId": "source:project-wulfila-john-12-38",
      "role": "supports",
      "locator": "John 12:38, fol. 78r (facsimile 99). The tokens hauseinai and unsarai give the second possessive example in its inflected form."
    },
    {
      "sourceId": "source:uppsala-history-of-codex-argenteus",
      "role": "supports",
      "locator": "Opening paragraphs, Materials, and Codex argenteus’ journey: likely early-sixth-century Ravenna production; material and script; leaf counts, Uppsala and the Speyer find."
    },
    {
      "sourceId": "source:uppsala-silver-bible-cross-references",
      "role": "supports",
      "locator": "Object description following the interview with Lars Munkhammar, particularly the four arches, one for each evangelist, and their use as Gospel cross-references."
    },
    {
      "sourceId": "source:project-wulfila-gothic-manuscripts",
      "role": "supports",
      "locator": "Entries 1 (Codex Argenteus, Uppsala DG 1, Gospel order) and 13 (Fragmentum Spirense, end of Mark 16)."
    },
    {
      "sourceId": "source:uppsala-codex-argenteus-john-photo",
      "role": "supports",
      "locator": "Image description, attribution and CC0 licensing; source digitisation Uppsala University Library, Alvin record 60279."
    }
  ],
