  "sourceRefs": [
    {
      "sourceId": "source:ghent-madelinus-obverse",
      "role": "supports",
      "locator": "Object 800000085493, De Bast 113. Obverse, weight 1.19 g, diameter 12 mm, collection range 600–670 and CC0 file statement."
    },
    {
      "sourceId": "source:ghent-madelinus-reverse",
      "role": "supports",
      "locator": "Object 800000085493, reverse photograph and transcription, two rows of pellets beneath the cross. File licensing section, CC0 1.0."
    },
    {
      "sourceId": "source:berlin-madelinus-18208309",
      "role": "supports",
      "locator": "Object 18208309, legends and commentary after the bibliography. Parallel specimen. The name is also known at Maastricht and probably continued after the moneyer’s death."
    },
    {
      "sourceId": "source:museum-thorn-madelinus",
      "role": "supports",
      "locator": "Object description, first paragraph. Found near Thorn in 2009, struck at Maastricht around 625, its two inscriptions and moneyer."
    },
    {
      "sourceId": "source:maastricht-museum-early-crafts",
      "role": "supports",
      "locator": "Sections Artisanal centre and Trade centre. Glass, pottery, textiles and antler working, and twelve named Maastricht moneyers."
    },
    {
      "sourceId": "source:tys-merovingian-river-traders",
      "role": "supports",
      "locator": "The Oxford Handbook of the Merovingian World, pp. 772–774 and figs. 34.1–34.3. River settlements, two moneyers at Dorestad before its later port, Madelinus in the 630s and 640s and possible uses for gold coins."
    },
    {
      "sourceId": "source:british-museum-sutton-hoo-gold",
      "role": "supports",
      "locator": "Room 41, Gold coins. The 37 struck coins, three blanks and two ingots, Frankish mints and a suggested deposit between 610 and 635."
    },
    {
      "sourceId": "source:grierson-sutton-hoo-coins",
      "role": "supports",
      "locator": "Antiquity 44, pp. 14–18, opening paragraphs. Separate weights for struck coins, the three blanks and the two rectangular ingots."
    },
    {
      "sourceId": "source:jezeer-oegstgeest-excavation",
      "role": "supports",
      "locator": "ADC Rapport 2054 (revised December 2011), summary; §4.1.1 house 2 and well 12; C. Nooijen §8.2.1, fig. 8.1 and notes 96–97 for find 330, its metal, legends and estimated striking date."
    },
    {
      "sourceId": "source:national-trust-sutton-hoo-mound-one",
      "role": "derivation",
      "locator": "Monument 00400 / MNA108959, grid reference TM 2877 4869. Orientation point for Mound 1."
    },
    {
      "sourceId": "source:getty-tgn-maastricht",
      "role": "derivation",
      "locator": "TGN 7006862, coordinates 50.8500° N, 5.6833° E. These locate the modern city."
    },
    {
      "sourceId": "source:getty-tgn-dorestad",
      "role": "derivation",
      "locator": "TGN 7017400, historical name Dorestad and orientation at 51.9833° N, 5.3500° E."
    }
  ],
