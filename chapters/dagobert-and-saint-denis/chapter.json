  "sourceRefs": [
    {
      "sourceId": "source:artem-chlothar-paris-625",
      "role": "supports",
      "locator": "ARTEM 4505, Archives nationales K 1 no. 7/1, regest and ll. 3–7. Abbot Dodo, the donor Dagobert, whose father was Baddo, and a plot described as within the walls of Paris."
    },
    {
      "sourceId": "source:artem-dagobert-iticina",
      "role": "supports",
      "locator": "ARTEM 4504, Archives nationales K 1 no. 5, transmission, place, regest and ll. 1–3. Address to the duke, the domesticus Gaganricus and the agents, the estate and its former owners. The dated header gives 15 March 633."
    },
    {
      "sourceId": "source:artem-dagobert-ursinus",
      "role": "supports",
      "locator": "ARTEM 4507, Archives nationales AE II 3 (K 1 no. 9), regest and ll. 1–4. Petition, brothers, inherited property and Rouergue. Place of issue unidentified. This edition gives 637."
    },
    {
      "sourceId": "source:artem-clovis-parents-saint-denis",
      "role": "supports",
      "locator": "ARTEM 4511, Archives nationales AE II 6 (K 2 no. 3). Header, regest and ll. 3–4, naming the king’s parents Dagobert and Nanthild as buried in the basilica. Clichy, 22 June 654."
    },
    {
      "sourceId": "source:wallace-hadrill-fredegar-fourth-book",
      "role": "supports",
      "locator": "IV.79, pp. 66–67, including n. 1. Illness at Épinay, Aega, Nanthild, Clovis and burial at Saint-Denis. Wallace-Hadrill follows Courtois in dating the death to 638."
    },
    {
      "sourceId": "source:koelzer-merovingian-charters-2001",
      "role": "supports",
      "locator": "DD Mer. 28, pp. 75–77 (Paris plot); 32, pp. 87–89, especially ll. 3–7 (Ursinus, Beppoleno, maternal estate and mancipia; original ratification dated 629–637); 41, pp. 108–110 (Iticina, probably October 632, possibly into 633); 85, pp. 216–218 (royal privilege)."
    },
    {
      "sourceId": "source:cluny-merovingian-charters-2016",
      "role": "supports",
      "locator": "List of works, section II “Le pouvoir et ses témoignages”, nos. 15–16, catalogue pp. 25–26. Dimensions and date of Clovis II’s charter and the 629–639 range for Dagobert’s AE II 3."
    },
    {
      "sourceId": "source:atsma-vezin-saint-denis-654",
      "role": "supports",
      "locator": "pp. 353–355, particularly p. 354. Royal confirmation of Landry’s privilege, sung praise on the model of Agaune, signatories and the king’s parents."
    },
    {
      "sourceId": "source:saint-denis-excavated-necropolises",
      "role": "supports",
      "locator": "Sections “La basilique et ses deux nécropoles” and “Naissance du monastère”. Building extensions, 1959 discovery of the grave attributed to Arnegunde, more than 200 excavated northern burials, plaster sarcophagi and Dagobert’s patronage."
    },
    {
      "sourceId": "source:geschichtsquellen-gesta-dagoberti",
      "role": "supports",
      "locator": "Werk 2481 (BHL 2193), Beschreibung. Death of Dagobert in 639, composition by a monk of Saint-Denis between 830 and 835, and focus on his care for monasteries."
    },
    {
      "sourceId": "source:cmn-dagobert-tomb-narrative",
      "role": "supports",
      "locator": "Section H, “Le roi Dagobert”: tomb monument commissioned in the thirteenth century, the soul transported in a boat and rescued by Saints Denis, Maurice and Martin."
    },
    {
      "sourceId": "source:cmn-history-saint-denis-basilica",
      "role": "supports",
      "locator": "Introduction to the royal burials and section on the Merovingian basilica. Dagobert’s burial, present-day site and the date 639 used by the institution."
    },
    {
      "sourceId": "source:archives-nationales-dagobert-papyrus-facsimile",
      "role": "supports",
      "locator": "Description, collection, accession number AE/II/3 (K//1/9), source, permission and image history. The Archives nationales supplied the photograph; the current 1024 × 496 image is oriented for reading."
    }
  ],
